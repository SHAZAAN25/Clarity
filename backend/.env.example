# Application Configuration
APP_NAME=Clarity - AI Smoking Reduction & Cessation Coach
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Production: postgresql+psycopg2://user:password@localhost:5432/clarity_db
# Local fallback: sqlite:///./clarity_coach.db
DATABASE_URL=sqlite:///./clarity_coach.db

# LLM / AI Configuration (Modular Abstraction Layer)
# Supported Providers: local_fallback, openai, anthropic, gemini
LLM_PROVIDER=local_fallback
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6

# RAG & Embeddings
EMBEDDING_PROVIDER=local_fallback
VECTOR_DATABASE_URL=

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
